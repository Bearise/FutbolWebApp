38381>>>                // If from main, this is a probably a main-file lookup from a Zoom
38381>>>                WebSet pbRender of oDetailButton to False
38382>>>                Case Break
38383>>>
38383>>>            Case Else // must be nfUndefined
38383>>>                // This may be the start of a drilldown query or this may be used for some kind of custom query.
38383>>>
38383>>>        Case End
38383>>>
38383>>>    End_Procedure
