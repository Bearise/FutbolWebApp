37795>>>    Procedure SetActionButtons
37798>>>        tWebNavigateData NavigateData
37798>>>        tWebNavigateData NavigateData
37798>>>        Boolean bHasRecord
37798>>>        Handle hoDD
37798>>>
37798>>>        Get Server to hoDD
37799>>>        Get GetNavigateData to NavigateData
37800>>>        Get HasRecord of hoDD to bHasRecord
37801>>>
37801>>>        // let's hide all buttons and then Show the ones we want
37801>>>        WebSet pbRender of oEditBtn to False
37802>>>        WebSet pbRender of oSaveBtn to False
37803>>>        WebSet pbRender of oCancelChangesBtn to False
37804>>>        WebSet pbRender of oDeleteBtn to False
37805>>>
37805>>>        If (NavigateData.bReadOnly) Begin
37807>>>            WebSet pbRender of oEditBtn to True
37808>>>        End
37808>>>>
37808>>>        Else Begin
37809>>>            WebSet pbRender of oSaveBtn to True
37810>>>            WebSet pbRender of oCancelChangesBtn to True
37811>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37812>>>        End
37812>>>>
37812>>>    End_Procedure
